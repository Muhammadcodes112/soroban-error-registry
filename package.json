{
  "name": "soroban-error-registry",
  "version": "0.1.0",
  "description": "Open, human-written explanations for Soroban errors: host errors and contract error codes.",
  "main": "src/index.mjs",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:source": "node scripts/validate.mjs --check-source",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "errors",
    "debugging",
    "blend"
  ],
  "author": "Akinshola Akinniyi (https://github.com/Akshola00)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./tx": "./src/tx.mjs",
    "./registry.json": "./dist/registry.json",
    "./registry.mjs": "./dist/registry.mjs"
  },
  "bin": {
    "soroban-explain": "bin/explain.mjs"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Akshola00/soroban-error-registry"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
